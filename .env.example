# OpenAI API Configuration (used by every agent by default)
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic API Configuration — optional; only needed if you override one of the
# *_MODEL vars below to an anthropic:... model
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Google Maps Platform key: geocoding, directions, places, address validation, and weather
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# Google Custom Search (for search_web)
GOOGLE_SEARCH_API_KEY=your-google-search-api-key-here
GOOGLE_CSE_ID=your-google-cse-id-here

# Optional: override which model each agent uses (each is defined next to its
# builder: agent/supervisor.py and agent/workers/{research,location,timing,planning}.py)
# SUPERVISOR_MODEL=openai:gpt-4o
# RESEARCH_MODEL=openai:gpt-4o
# PLANNING_MODEL=openai:gpt-4o
# LOCATION_MODEL=openai:gpt-4o
# TIMING_MODEL=openai:gpt-4o